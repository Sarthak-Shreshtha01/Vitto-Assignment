# PostgreSQL connection strings (Supabase/Neon in production; can also point
# at the local docker-compose Postgres for local dev).
# DATABASE_URL: pooled connection (used by the app at runtime).
# DIRECT_URL: direct, non-pooled connection (used by Prisma Migrate — pgbouncer
# transaction-mode pooling doesn't support the prepared statements migrations need).
DATABASE_URL=
DIRECT_URL=

# Firebase client SDK config (safe to expose to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-side token verification). Never expose these.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
